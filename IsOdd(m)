.data
   m: .word 4			# initialize value
.text
.globl main

main:
   lw $a0, m			# load m into argument value
   jal IsOdd			# Call IsOdd(m)
  
   move $a0, $v0		# move result into a0
   li $v0, 1			# print result
   syscall 
   
   li $v0, 10			# exit
   syscall
   
IsOdd:
   move $t0, $a0		# use temporary value
 
Loop:
   blt $t0, 2, Done		# check remainder to determine if its odd or even
   addi $t0, $t0, -2		# division by repeated subtraction
   j Loop 			# Loop

Done:
   beq $t0, $zero, Even	# Even if remainder is 0
   li $v0, 1			# Return 1 (True) otherwise.
   jr $ra
   
Even:
   li $v0, 0			# Return 0 (False)
   jr $ra
